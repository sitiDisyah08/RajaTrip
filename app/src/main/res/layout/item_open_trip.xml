<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_trip_card"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="8dp">

    <!-- FOTO PAKET -->
    <ImageView
        android:id="@+id/imgTrip"
        android:layout_width="88dp"
        android:layout_height="120dp"
        android:scaleType="centerCrop"
        android:contentDescription="Foto paket Open Trip" />

    <!-- INFORMASI PAKET -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- JUDUL DAN FAVORIT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTripTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="#172D32"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnFavorite"
                android:layout_width="26dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:text="♡"
                android:textColor="#075B58"
                android:textSize="23sp"
                android:contentDescription="Favorit" />
        </LinearLayout>

        <!-- LOKASI -->
        <TextView
            android:id="@+id/tvTripLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#7A858F"
            android:textSize="10sp" />

        <!-- RATING BINTANG -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="★"
                android:textColor="#FFB000"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/tvTripRating"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#34424C"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- HARGA -->
        <TextView
            android:id="@+id/tvTripPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="end"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="11sp"
            android:autoSizeMaxTextSize="14sp"
            android:autoSizeStepGranularity="1sp"
            android:textColor="#172D32"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- DURASI DAN HARGA PER ORANG -->
        <TextView
            android:id="@+id/tvTripDuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:gravity="end"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#08756F"
            android:textSize="10sp" />

        <!-- FASILITAS -->
        <TextView
            android:id="@+id/tvTripFacilities"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="#08756F"
            android:textSize="9sp"
            android:lineSpacingExtra="1dp" />

    </LinearLayout>

</LinearLayout>
