<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="14dp"
    android:paddingEnd="10dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp"
    android:background="@drawable/bg_success_popup">

    <!-- Ikon centang hijau -->
    <TextView
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:gravity="center"
        android:background="@drawable/bg_success_check"
        android:text="✓"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- Judul dan pesan -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="6dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Password berhasil diubah!"
            android:textColor="#17323B"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Kamu akan diarahkan ke halaman login dalam beberapa detik."
            android:textColor="#7B858B"
            android:textSize="11sp"
            android:lineSpacingExtra="2dp" />
    </LinearLayout>

    <!-- Tombol tutup -->
    <TextView
        android:id="@+id/btnCloseSuccess"
        android:layout_width="25dp"
        android:layout_height="35dp"
        android:gravity="top|center_horizontal"
        android:text="×"
        android:textColor="#9AA3A7"
        android:textSize="22sp"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Tutup notifikasi" />

</LinearLayout>
