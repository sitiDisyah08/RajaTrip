<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F6F1">

    <!-- Foto Raja Ampat -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_gravity="top"
        android:src="@drawable/raja_ampat"
        android:scaleType="centerCrop"
        android:contentDescription="Pemandangan Raja Ampat" />

    <!-- Overlay foto -->
    <View
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_gravity="top"
        android:background="#44001B24" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:orientation="vertical"
                android:paddingStart="26dp"
                android:paddingEnd="26dp"
                android:paddingTop="16dp">

                <TextView
                    android:id="@+id/tvBackLogin"
                    android:layout_width="44dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="‹"
                    android:textColor="#FFFFFF"
                    android:textSize="32sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Kembali ke login" />

                <!-- Logo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏝"
                        android:textSize="38sp"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RAJATRIP"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.12" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="36dp"
                    android:text="Atur Password Baru"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Buat password baru untuk mengamankan\nakun kamu."
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp" />

            </LinearLayout>

            <!-- KARTU ATUR PASSWORD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:layout_marginTop="-4dp"
                android:orientation="vertical"
                android:background="@drawable/bg_forgot_card"
                android:elevation="6dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="18dp"
                android:paddingBottom="22dp">

                <!-- Ikon gembok -->
                <FrameLayout
                    android:layout_width="66dp"
                    android:layout_height="66dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_forgot_icon">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="🔐"
                        android:textSize="30sp"
                        android:contentDescription="Ikon keamanan password" />
                </FrameLayout>

                <!-- LABEL PASSWORD BARU -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Password Baru"
                    android:textColor="#17323B"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- INPUT PASSWORD BARU -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="7dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_forgot_email"
                    android:paddingStart="12dp"
                    android:paddingEnd="10dp">

                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="♙"
                        android:textColor="#89969A"
                        android:textSize="19sp" />

                    <EditText
                        android:id="@+id/etNewPassword"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:paddingStart="8dp"
                        android:paddingEnd="4dp"
                        android:hint="Masukkan password baru"
                        android:singleLine="true"
                        android:inputType="textPassword"
                        android:textColor="#17323B"
                        android:textColorHint="#89969A"
                        android:textSize="12sp"
                        android:autofillHints="newPassword" />

                    <TextView
                        android:id="@+id/tvToggleNewPassword"
                        android:layout_width="34dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="◉"
                        android:textColor="#89969A"
                        android:textSize="19sp"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Tampilkan password baru" />
                </LinearLayout>

                <!-- PERSYARATAN PASSWORD -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Password harus terdiri dari:"
                    android:textColor="#17323B"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="✓  Minimal 8 karakter\n✓  Mengandung huruf besar dan kecil\n✓  Mengandung angka\n✓  Mengandung minimal 1 karakter khusus (!@#$%)"
                    android:textColor="#68777D"
                    android:textSize="10sp"
                    android:lineSpacingExtra="4dp" />

                <!-- LABEL KONFIRMASI -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="Konfirmasi Password"
                    android:textColor="#17323B"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- INPUT KONFIRMASI PASSWORD -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="7dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_forgot_email"
                    android:paddingStart="12dp"
                    android:paddingEnd="10dp">

                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="♙"
                        android:textColor="#89969A"
                        android:textSize="19sp" />

                    <EditText
                        android:id="@+id/etConfirmPassword"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:paddingStart="8dp"
                        android:paddingEnd="4dp"
                        android:hint="Masukkan ulang password baru"
                        android:singleLine="true"
                        android:inputType="textPassword"
                        android:textColor="#17323B"
                        android:textColorHint="#89969A"
                        android:textSize="12sp"
                        android:autofillHints="newPassword" />

                    <TextView
                        android:id="@+id/tvToggleConfirmPassword"
                        android:layout_width="34dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="◉"
                        android:textColor="#89969A"
                        android:textSize="19sp"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Tampilkan konfirmasi password" />
                </LinearLayout>

                <!-- TOMBOL SIMPAN -->


                <Button
                    android:id="@+id/btnSavePassword"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_save_password"
                    android:backgroundTint="@null"
                    android:text="Simpan Password"
                    android:textColor="#FFFFFF"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:stateListAnimator="@null" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</FrameLayout>
