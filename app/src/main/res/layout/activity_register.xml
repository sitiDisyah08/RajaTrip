<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F6F1">

    <!-- Foto latar Raja Ampat -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_gravity="top"
        android:src="@drawable/raja_ampat"
        android:scaleType="centerCrop"
        android:contentDescription="Pemandangan Raja Ampat" />

    <!-- Overlay foto -->
    <View
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_gravity="top"
        android:background="#44001B24" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Header RajaTrip -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="12dp">

                <TextView
                    android:id="@+id/tvBackRegister"
                    android:layout_width="42dp"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:text="‹"
                    android:textColor="#FFFFFF"
                    android:textSize="32sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Kembali ke login" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏝"
                        android:textSize="34sp"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RAJATRIP"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.12" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Buat Akun Baru"
                    android:textColor="#FFFFFF"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Mulai perjalanan seru kamu ke Raja Ampat&#10;dengan membuat akun terlebih dahulu."
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp" />

            </LinearLayout>

            <!-- Kartu formulir pendaftaran -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:orientation="vertical"
                android:background="@drawable/bg_forgot_card"
                android:elevation="6dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="18dp"
                android:paddingBottom="20dp">

                <!-- Nama lengkap -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nama Lengkap"
                    android:textColor="#17323B"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etFullName"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_forgot_email"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:hint="♟   Masukkan nama lengkap"
                    android:singleLine="true"
                    android:inputType="textPersonName|textCapWords"
                    android:textColor="#17323B"
                    android:textColorHint="#89969A"
                    android:textSize="12sp"
                    android:autofillHints="name" />

                <!-- Email -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Email Address"
                    android:textColor="#17323B"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etRegisterEmail"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_forgot_email"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:hint="✉   nama@email.com"
                    android:singleLine="true"
                    android:inputType="textEmailAddress"
                    android:textColor="#17323B"
                    android:textColorHint="#89969A"
                    android:textSize="12sp"
                    android:autofillHints="emailAddress" />

                <!-- Nomor telepon -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nomor Telepon"
                    android:textColor="#17323B"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etPhone"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_forgot_email"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:hint="☎   08XXXXXXXXXX"
                    android:singleLine="true"
                    android:inputType="phone"
                    android:textColor="#17323B"
                    android:textColorHint="#89969A"
                    android:textSize="12sp"
                    android:autofillHints="phone" />

                <!-- Password -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Password"
                    android:textColor="#17323B"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_forgot_email"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp">

                    <EditText
                        android:id="@+id/etRegisterPassword"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:paddingStart="2dp"
                        android:paddingEnd="4dp"
                        android:hint="♙   Masukkan password"
                        android:singleLine="true"
                        android:inputType="textPassword"
                        android:textColor="#17323B"
                        android:textColorHint="#89969A"
                        android:textSize="12sp"
                        android:autofillHints="newPassword" />

                    <TextView
                        android:id="@+id/tvToggleRegisterPassword"
                        android:layout_width="32dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="◉"
                        android:textColor="#89969A"
                        android:textSize="17sp"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Tampilkan password" />
                </LinearLayout>

                <!-- Konfirmasi password -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Konfirmasi Password"
                    android:textColor="#17323B"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_forgot_email"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp">

                    <EditText
                        android:id="@+id/etConfirmPassword"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:paddingStart="2dp"
                        android:paddingEnd="4dp"
                        android:hint="♙   Masukkan ulang password"
                        android:singleLine="true"
                        android:inputType="textPassword"
                        android:textColor="#17323B"
                        android:textColorHint="#89969A"
                        android:textSize="12sp"
                        android:autofillHints="newPassword" />

                    <TextView
                        android:id="@+id/tvToggleConfirmRegisterPassword"
                        android:layout_width="32dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="◉"
                        android:textColor="#89969A"
                        android:textSize="17sp"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Tampilkan konfirmasi password" />
                </LinearLayout>

                <!-- Persetujuan -->
                <CheckBox
                    android:id="@+id/cbTerms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:buttonTint="#08756F"
                    android:gravity="center_vertical"
                    android:paddingStart="3dp"
                    android:text="Saya setuju dengan Syarat &amp; Ketentuan dan Kebijakan Privasi RajaTrip."
                    android:textColor="#17323B"
                    android:textSize="10sp" />

                <!-- Tombol daftar -->
                <Button
                    android:id="@+id/btnRegister"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_save_password"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null"
                    android:text="Daftar Sekarang"
                    android:textColor="#FFFFFF"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Pemisah sosial -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="12dp">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#CBD2D2" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="   atau daftar dengan   "
                        android:textColor="#68777D"
                        android:textSize="10sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#CBD2D2" />
                </LinearLayout>

                <!-- Tombol sosial Google, Facebook, Apple -->
                <LinearLayout
                    android:id="@+id/socialLoginContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp">

                    <ImageButton
                        android:id="@+id/btnGoogle"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginHorizontal="10dp"
                        android:background="@drawable/bg_social_circle"
                        android:src="@drawable/ic_google"
                        android:scaleType="fitCenter"
                        android:padding="11dp"
                        android:contentDescription="Google"
                        android:clickable="true"
                        android:focusable="true" />

                    <ImageButton
                        android:id="@+id/btnFacebook"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginHorizontal="10dp"
                        android:background="@drawable/bg_social_circle"
                        android:src="@drawable/ic_facebook"
                        android:scaleType="fitCenter"
                        android:padding="11dp"
                        android:contentDescription="Facebook"
                        android:clickable="true"
                        android:focusable="true" />

                    <ImageButton
                        android:id="@+id/btnApple"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginHorizontal="10dp"
                        android:background="@drawable/bg_social_circle"
                        android:src="@drawable/ic_apple"
                        android:scaleType="fitCenter"
                        android:padding="11dp"
                        android:contentDescription="Apple"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

                <!-- Kembali ke login -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sudah punya akun? "
                        android:textColor="#68777D"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvLoginFromRegister"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Login"
                        android:textColor="#08756F"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</FrameLayout>
